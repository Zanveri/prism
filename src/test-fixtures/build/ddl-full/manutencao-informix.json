  "expected": "-- Modelo manutencao · Informix · gerado pelo Prism 0.6.0 em 29/10/2026 14:32\n-- Tudo: o esquema inteiro, do zero, com as existentes como estão no modelo.\n-- Em MES Produção / mes falha no primeiro CREATE: as existentes já estão lá.\n\nCREATE TABLE producao.maquina (\n  id                BIGSERIAL,\n  linha_id          bigint NOT NULL,\n  tag               varchar(12) NOT NULL,\n  modelo            varchar(60),\n  instalada_em      date,\n  ultima_revisao_em date,\n  PRIMARY KEY (id) CONSTRAINT maquina_pkey,\n  FOREIGN KEY (linha_id)\n    REFERENCES producao.linha (id) CONSTRAINT maquina_linha_id_fkey\n);\n\nCREATE TABLE producao.operador (\n  id        BIGSERIAL,\n  matricula varchar(12) NOT NULL,\n  nome      varchar(80) NOT NULL,\n  turno     char(1),\n  PRIMARY KEY (id) CONSTRAINT operador_pkey\n);\n\nCREATE TABLE producao.produto (\n  id        BIGSERIAL,\n  codigo    varchar(20) NOT NULL,\n  descricao varchar(120) NOT NULL,\n  unidade   char(2) NOT NULL,\n  ativo     boolean DEFAULT 't' NOT NULL,\n  PRIMARY KEY (id) CONSTRAINT produto_pkey\n);\n\nCREATE TABLE manutencao.plano_manutencao (\n  id                 BIGSERIAL,\n  maquina_id         bigint NOT NULL,\n  descricao          varchar(120) NOT NULL,\n  periodicidade_dias integer NOT NULL,\n  ativo              boolean DEFAULT 't' NOT NULL,\n  PRIMARY KEY (id) CONSTRAINT pk_plano_manutencao,\n  FOREIGN KEY (maquina_id)\n    REFERENCES producao.maquina (id) CONSTRAINT fk_plano_manutencao_maquina\n);\n\n-- Ordem de serviço de manutenção de uma máquina\nCREATE TABLE manutencao.ordem_manutencao (\n  id         BIGSERIAL,\n  maquina_id bigint NOT NULL,\n  plano_id   bigint,\n  aberta_por bigint NOT NULL,\n  -- Corretiva quando a máquina parou; preventiva quando veio do plano\n  tipo       varchar(12) DEFAULT 'corretiva' NOT NULL,\n  status     varchar(12) DEFAULT 'aberta' NOT NULL,\n  aberta_em  datetime year to second DEFAULT CURRENT YEAR TO SECOND NOT NULL,\n  fechada_em datetime year to second,\n  PRIMARY KEY (id) CONSTRAINT pk_ordem_manutencao,\n  CHECK (tipo IN ('corretiva', 'preventiva')) CONSTRAINT ck_ordem_manutencao_tipo,\n  FOREIGN KEY (maquina_id)\n    REFERENCES producao.maquina (id) CONSTRAINT fk_ordem_manutencao_maquina,\n  FOREIGN KEY (plano_id)\n    REFERENCES manutencao.plano_manutencao (id) CONSTRAINT fk_ordem_manutencao_plano_manutencao,\n  FOREIGN KEY (aberta_por)\n    REFERENCES producao.operador (id) CONSTRAINT fk_ordem_manutencao_operador\n);\n\nCREATE TABLE manutencao.peca_trocada (\n  id         BIGSERIAL,\n  ordem_id   bigint NOT NULL,\n  produto_id integer NOT NULL,\n  quantidade decimal(12,3) NOT NULL,\n  custo      decimal(12,2),\n  PRIMARY KEY (id) CONSTRAINT pk_peca_trocada,\n  FOREIGN KEY (ordem_id)\n    REFERENCES manutencao.ordem_manutencao (id) ON DELETE CASCADE CONSTRAINT fk_peca_trocada_ordem_manutencao,\n  FOREIGN KEY (produto_id)\n    REFERENCES producao.produto (id) CONSTRAINT fk_peca_trocada_produto\n);\n\nCREATE INDEX ix_ordem_manutencao_maquina\n  ON manutencao.ordem_manutencao (maquina_id, aberta_em);\nCREATE INDEX ix_ordem_manutencao_status\n  ON manutencao.ordem_manutencao (status);"
}
