{
  "dbml": "// as tabelas novas e, no fim, as existentes: o que mudar nelas vira ALTER\n\nTable manutencao.ordem_manutencao {\n  id bigint [pk, increment]\n  maquina_id bigint [not null, ref: > producao.maquina.id]\n  plano_id bigint\n  aberta_por bigint [not null, ref: > producao.operador.id]\n  tipo varchar(12) [not null, default: 'corretiva', check: `tipo IN ('corretiva', 'preventiva')`, note: 'Corretiva quando a máquina parou; preventiva quando veio do plano']\n  status varchar(12) [not null, default: 'aberta']\n  aberta_em timestamptz [not null, default: `now()`]\n  fechada_em timestamptz\n\n  Indexes {\n    (maquina_id, aberta_em) [name: 'ix_ordem_manutencao_maquina']\n    status [name: 'ix_ordem_manutencao_status']\n  }\n  Note: 'Ordem de serviço de manutenção de uma máquina'\n}\n\nTable manutencao.plano_manutencao {\n  id bigint [pk, increment]\n  maquina_id bigint [not null, ref: > producao.maquina.id]\n  descricao varchar(120) [not null]\n  periodicidade_dias integer [not null]\n  ativo boolean [not null, default: true]\n}\n\nTable manutencao.peca_trocada {\n  id bigint [pk, increment]\n  ordem_id bigint [not null]\n  produto_id integer [not null, ref: > producao.produto.id]\n  quantidade numeric(12,3) [not null]\n  custo numeric(12,2)\n}\n\nRef: manutencao.ordem_manutencao.plano_id > manutencao.plano_manutencao.id [delete: set null]\nRef: manutencao.peca_trocada.ordem_id > manutencao.ordem_manutencao.id [delete: cascade]\n\n// existentes em mes\nTable producao.maquina {\n  id bigint [pk, increment]\n  linha_id bigint [not null, ref: > producao.linha.id]\n  tag varchar(12) [not null]\n  modelo varchar(60)\n  instalada_em date\n  ultima_revisao_em date\n}\n\nTable producao.operador {\n  id bigint [pk, increment]\n  matricula varchar(12) [not null]\n  nome varchar(80) [not null]\n  turno char(1)\n}\n\nTable producao.produto {\n  id bigint [pk, increment]\n  codigo varchar(20) [not null]\n  descricao varchar(120) [not null]\n  unidade char(2) [not null]\n  ativo boolean [not null, default: true]\n}",
