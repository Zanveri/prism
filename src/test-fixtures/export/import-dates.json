{
  "rule": "RN-IMPORT-010 e 028: a data, a data e hora e a hora de cada formato (aaaa-mm-dd e dd/mm/aaaa), com o texto canônico esperado ou a recusa, o fuso, as casas de fração do Db2 e do Informix e os campos depois do último do DATETIME YEAR TO DAY, HOUR e MINUTE do Informix. Só da API (ImportValues.Convert), pronta para quando a tela converter.",
  "notes": [
    "Os campos são os de import-value-order.json."
  ],
  "cases": [
    {
      "name": "a data",
      "engine": "postgresql",
      "type": "date",
      "column": "valor",
      "value": "2024-01-15",
      "source": "plain",
      "formats": {
        "decimal": "point",
        "thousandsDot": false,
        "dates": "iso"
      },
      "expected": "2024-01-15"
    },
    {
      "name": "a data com um dígito no mês",
      "engine": "postgresql",
      "type": "date",
      "column": "valor",
      "value": "2024-1-15",
      "source": "plain",
      "formats": {
        "decimal": "point",
        "thousandsDot": false,
        "dates": "iso"
      },
      "refusal": "«2024-1-15» não é uma data no formato aaaa-mm-dd."
    },
    {
      "name": "a data que não existe",
      "engine": "postgresql",
      "type": "date",
      "column": "valor",
      "value": "2024-02-31",
      "source": "plain",
      "formats": {
        "decimal": "point",
        "thousandsDot": false,
        "dates": "iso"
      },
      "refusal": "«2024-02-31» não é uma data válida."
    },
