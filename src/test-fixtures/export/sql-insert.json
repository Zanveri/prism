        ]
      ],
      "expected": "INSERT INTO \"pedido\" (\"id\") VALUES\n  (1);\n",
      "skippedRows": 0
    },
    {
      "name": "nomes hostis entre aspas, com a aspa dobrada",
      "engine": "postgresql",
      "options": {
        "schema": "es\"q",
        "table": "ped;ido",
        "omitSchema": false,
        "rowsPerStatement": 1
      },
      "columns": [
        {
          "name": "a\"b",
          "type": "text",
          "kind": "text"
        },
        {
          "name": "--c",
          "type": "text",
          "kind": "text"
        }
      ],
      "rows": [
        [
          "x",
          "y"
        ]
      ],
      "expected": "INSERT INTO \"es\"\"q\".\"ped;ido\" (\"a\"\"b\", \"--c\") VALUES ('x', 'y');\n",
      "skippedRows": 0
    },
