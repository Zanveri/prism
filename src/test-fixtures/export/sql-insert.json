    {
      "name": "a linha com controle fecha o comando e vira comentário",
      "engine": "postgresql",
      "options": {
        "schema": null,
        "table": "pedido",
        "omitSchema": false,
        "rowsPerStatement": 10
      },
      "columns": [
        {
          "name": "id",
          "type": "int4",
          "kind": "number"
        },
        {
          "name": "nome",
          "type": "text",
          "kind": "text"
        }
      ],
      "rows": [
        [
          "1",
          "a"
        ],
        [
          "2",
          "x\u0001y"
        ],
        [
          "3",
          "c"
        ]
      ],
      "expected": "INSERT INTO \"pedido\" (\"id\", \"nome\") VALUES\n  (1, 'a');\n-- Linha 2 não exportada: um valor tem caractere de controle que não vira literal.\nINSERT INTO \"pedido\" (\"id\", \"nome\") VALUES\n  (3, 'c');\n",
      "skippedRows": 1
    },
    {
      "name": "a linha pulada depois de um comando cheio não fecha outro",
      "engine": "postgresql",
      "options": {
        "schema": null,
        "table": "t",
        "omitSchema": false,
        "rowsPerStatement": 3
      },
      "columns": [
        {
          "name": "v",
          "type": "text",
          "kind": "text"
        }
      ],
      "rows": [
        [
          "1"
        ],
        [
          "2"
        ],
        [
          "3"
        ],
        [
          "4\u007f"
        ],
        [
          "5"
        ]
      ],
      "expected": "INSERT INTO \"t\" (\"v\") VALUES\n  ('1'),\n  ('2'),\n  ('3');\n-- Linha 4 não exportada: um valor tem caractere de controle que não vira literal.\nINSERT INTO \"t\" (\"v\") VALUES\n  ('5');\n",
      "skippedRows": 1
    },
    {
      "name": "duas linhas puladas seguidas",
      "engine": "db2",
      "options": {
        "schema": null,
        "table": "t",
        "omitSchema": false,
        "rowsPerStatement": 2
      },
      "columns": [
        {
          "name": "v",
          "type": "VARCHAR",
          "kind": "text"
        }
      ],
      "rows": [
        [
          "\u0000"
        ],
        [
          "\u001b"
        ],
        [
          "ok"
        ]
      ],
      "expected": "-- Linha 1 não exportada: um valor tem caractere de controle que não vira literal.\n-- Linha 2 não exportada: um valor tem caractere de controle que não vira literal.\nINSERT INTO \"t\" (\"v\") VALUES\n  ('ok');\n",
      "skippedRows": 2
    },
    {
      "name": "Informix: o binário vira comentário",
      "engine": "informix",
      "options": {
        "schema": null,
        "table": "pedido",
        "omitSchema": false,
        "rowsPerStatement": 1
      },
      "columns": [
        {
