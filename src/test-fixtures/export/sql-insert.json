{
  "rule": "RN-EXPORT-011: o arquivo SQL inteiro, com várias linhas por comando e as linhas sem literal. Só da API (SqlExportWriter), pronta para quando a tela o escrever.",
  "notes": [
    "options: schema (null é sem esquema), table, omitSchema e rowsPerStatement; o binário é sempre o literal do banco.",
    "columns: name, type (o tipo do banco) e kind (o da grade). Cada valor de rows é texto, null, { codePoints: [...] } ou { bytes: \"HEX\" }.",
    "expected é o texto do arquivo em UTF-8 (o par solto já como U+FFFD); skippedRows, as linhas que viraram comentário."
  ],
  "cases": [
    {
      "name": "dez linhas por comando, duas linhas",
      "engine": "postgresql",
      "options": {
        "schema": "estoque",
        "table": "pedido",
        "omitSchema": false,
        "rowsPerStatement": 10
      },
      "columns": [
        {
          "name": "id",
          "type": "int4",
          "kind": "number"
        },
        {
          "name": "cliente",
          "type": "text",
          "kind": "text"
        },
        {
          "name": "criado",
          "type": "timestamp",
          "kind": "datetime"
        }
      ],
      "rows": [
        [
          "1",
          "Ana",
          "2024-01-15 10:30:00.000000"
        ],
        [
          "2",
          "Bia",
          null
        ]
      ],
      "expected": "INSERT INTO \"estoque\".\"pedido\" (\"id\", \"cliente\", \"criado\") VALUES\n  (1, 'Ana', '2024-01-15 10:30:00.000000'),\n  (2, 'Bia', NULL);\n",
      "skippedRows": 0
    },
    {
      "name": "uma linha por comando",
      "engine": "postgresql",
      "options": {
        "schema": "estoque",
        "table": "pedido",
        "omitSchema": false,
        "rowsPerStatement": 1
      },
      "columns": [
        {
          "name": "id",
          "type": "int4",
          "kind": "number"
        },
        {
          "name": "cliente",
          "type": "text",
          "kind": "text"
        },
        {
          "name": "criado",
          "type": "timestamp",
          "kind": "datetime"
        }
      ],
      "rows": [
        [
          "1",
          "Ana",
          "2024-01-15 10:30:00.000000"
        ],
        [
          "2",
          "Bia",
          null
        ]
      ],
      "expected": "INSERT INTO \"estoque\".\"pedido\" (\"id\", \"cliente\", \"criado\") VALUES (1, 'Ana', '2024-01-15 10:30:00.000000');\nINSERT INTO \"estoque\".\"pedido\" (\"id\", \"cliente\", \"criado\") VALUES (2, 'Bia', NULL);\n",
      "skippedRows": 0
    },
    {
      "name": "duas linhas por comando, cinco linhas",
      "engine": "db2",
      "options": {
        "schema": "estoque",
        "table": "pedido",
        "omitSchema": false,
        "rowsPerStatement": 2
      },
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "kind": "number"
        }
      ],
      "rows": [
        [
          "1"
        ],
        [
          "2"
        ],
        [
          "3"
        ],
        [
          "4"
        ],
        [
          "5"
        ]
      ],
      "expected": "INSERT INTO \"estoque\".\"pedido\" (\"id\") VALUES\n  (1),\n  (2);\nINSERT INTO \"estoque\".\"pedido\" (\"id\") VALUES\n  (3),\n  (4);\nINSERT INTO \"estoque\".\"pedido\" (\"id\") VALUES\n  (5);\n",
      "skippedRows": 0
    },
