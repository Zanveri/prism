      ],
      "expected": "-- Linha 1 não exportada: o Informix não tem literal para binário.\nINSERT INTO \"pedido\" (\"id\", \"foto\") VALUES (2, NULL);\n",
      "skippedRows": 1
    },
    {
      "name": "Informix: a data e hora de seis casas vira comentário",
      "engine": "informix",
      "options": {
        "schema": null,
        "table": "pedido",
        "omitSchema": false,
        "rowsPerStatement": 1
      },
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "kind": "number"
        },
        {
          "name": "criado",
          "type": "DATETIME YEAR TO FRACTION(5)",
          "kind": "datetime"
        }
      ],
      "rows": [
        [
          "1",
          "2024-01-15 10:30:00.123456"
        ],
        [
          "2",
          "2024-01-15 10:30:00.123450"
        ]
      ],
      "expected": "-- Linha 1 não exportada: no Informix, a data e hora tem mais de cinco casas de segundo.\nINSERT INTO \"pedido\" (\"id\", \"criado\") VALUES (2, DATETIME (2024-01-15 10:30:00.12345) YEAR TO FRACTION(5));\n",
      "skippedRows": 1
    },
    {
      "name": "Informix: sempre uma linha por comando, com o lógico e a quebra por CHR",
      "engine": "informix",
      "options": {
        "schema": "loja",
        "table": "pedido",
        "omitSchema": false,
        "rowsPerStatement": 10
      },
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "kind": "number"
        },
        {
          "name": "obs",
          "type": "LVARCHAR",
          "kind": "text"
        },
        {
          "name": "ativo",
          "type": "BOOLEAN",
          "kind": "boolean"
        }
      ],
      "rows": [
        [
          "1",
          "a\nb",
          "true"
        ],
        [
          "2",
          "c",
          "false"
        ]
      ],
      "expected": "INSERT INTO \"loja\".\"pedido\" (\"id\", \"obs\", \"ativo\") VALUES (1, 'a' || CHR(10) || 'b', 't');\nINSERT INTO \"loja\".\"pedido\" (\"id\", \"obs\", \"ativo\") VALUES (2, 'c', 'f');\n",
      "skippedRows": 0
    },
