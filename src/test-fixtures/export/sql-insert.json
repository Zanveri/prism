    {
      "name": "PostgreSQL: o retorno de carro de um json e de uma lista vai como \\r num E'…', um literal só",
      "engine": "postgresql",
      "options": {
        "schema": "loja",
        "table": "documento",
        "omitSchema": false,
        "rowsPerStatement": 10
      },
      "columns": [
        {
          "name": "id",
          "type": "int4",
          "kind": "number"
        },
        {
          "name": "conteudo",
          "type": "json",
          "kind": "text"
        },
        {
          "name": "marcas",
          "type": "_text",
          "kind": "text"
        }
      ],
      "rows": [
        [
          "1",
          "{\"a\":\r\n\"O'Brien \\\\ x\"}",
          "{\"x\ry\",z}"
        ],
        [
          "2",
          null,
          "{}"
        ]
      ],
      "expected": "INSERT INTO \"loja\".\"documento\" (\"id\", \"conteudo\", \"marcas\") VALUES\n  (1, E'{\"a\":\\r\n\"O''Brien \\\\\\\\ x\"}', E'{\"x\\ry\",z}'),\n  (2, NULL, '{}');\n",
      "skippedRows": 0
    },
    {
      "name": "o par substituto solto sai como U+FFFD",
      "engine": "postgresql",
      "options": {
        "schema": null,
        "table": "t",
        "omitSchema": false,
        "rowsPerStatement": 10
      },
      "columns": [
        {
          "name": "v",
          "type": "text",
          "kind": "text"
        }
      ],
      "rows": [
        [
          {
            "codePoints": [
              97,
              55357
            ]
          }
        ]
      ],
      "expected": "INSERT INTO \"t\" (\"v\") VALUES\n  ('a\ufffd');\n",
      "skippedRows": 0
    }
  ]
}
