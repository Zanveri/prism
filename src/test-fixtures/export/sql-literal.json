{
  "rule": "RN-EXPORT-011 e 024: o literal do SQL. Na tela, sqlLiteral (table-sql.ts) e scriptLiteral (grid-export/script-literal.ts); na API, ExportText.SqlLiteral e ExportText.ScriptLiteral.",
  "notes": [
    "function: sqlLiteral (o literal de uma linha só, o do filtro) ou scriptLiteral (o do script, com quebra de linha, retorno de carro e tabulação).",
    "engine: postgresql, db2 ou informix (1, 2 e 3 na tela). kind: o tipo da coluna na grade (text, number, datetime, boolean ou binary).",
    "value e expected são texto ou { codePoints: [...] }, que cada lado monta ponto de código por ponto de código; expected null é: o valor não tem literal."
  ],
  "cases": [
    {
      "name": "texto simples (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "Ana",
      "expected": "'Ana'"
    },
    {
      "name": "aspa dobrada (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "O'Brien",
      "expected": "'O''Brien'"
    },
    {
      "name": "quebra de linha não cabe numa linha (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "linha1\nlinha2",
      "expected": null
    },
    {
      "name": "retorno de carro não cabe numa linha (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "a\rb",
      "expected": null
    },
    {
      "name": "tabulação não cabe numa linha (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "a\tb",
      "expected": null
    },
    {
      "name": "U+0000 não tem literal (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "a\u0000b",
      "expected": null
    },
    {
      "name": "DEL não tem literal (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "a\u007fb",
      "expected": null
    },
    {
      "name": "ESC não tem literal (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "a\u001bb",
      "expected": null
    },
    {
      "name": "controle C1 vai entre aspas (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "a\u0085b",
      "expected": "'a\u0085b'"
    },
    {
      "name": "emoji e ideogramas, fora do plano básico (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "🙂 漢字 👨\u200d👩\u200d👧",
      "expected": "'🙂 漢字 👨\u200d👩\u200d👧'"
    },
    {
      "name": "U+202E, U+FEFF e U+FFFE ficam como estão (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": "a\u202eb\ufeffc\ufffe",
      "expected": "'a\u202eb\ufeffc\ufffe'"
    },
    {
      "name": "par substituto solto fica como está (postgresql)",
      "function": "sqlLiteral",
      "engine": "postgresql",
      "kind": "text",
      "value": {
        "codePoints": [
          97,
          55357,
          98
        ]
      },
      "expected": {
        "codePoints": [
          39,
          97,
          55357,
          98,
          39
        ]
      }
    },
