      "formats": {
        "decimal": "point",
        "thousandsDot": false,
        "dates": "iso"
      },
      "expected": "1500"
    },
    {
      "name": "Db2: o inteiro com casas",
      "engine": "db2",
      "type": "INTEGER",
      "column": "valor",
