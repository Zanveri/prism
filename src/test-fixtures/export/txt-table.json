        "headerLine": true,
        "edgeDelimiters": true,
        "minWidth": 3,
        "maxWidth": 0,
        "showNull": false,
        "lineBreak": "crlf"
      },
      "expected": "|id |\r\n|---|\r\n|1  |\r\n",
      "cutValues": 0
    },
