{
  "rule": "RN-EXPORT-008: a tabela de texto do DBeaver, para um lote só (até 200 linhas). Na tela, txtWriter (to-txt.ts); na API, TxtExportWriter. cutValues é quantos valores foram cortados na largura máxima.",
  "notes": [
    "columns são os nomes; rows são texto ou null; options são as da rota (lineBreak crlf ou lf)."
  ],
  "cases": [
    {
      "name": "padrões",
      "columns": [
        "id",
        "nome",
        "criado"
      ],
      "rows": [
        [
          "1",
          "Bruna",
          "2024-01-15"
        ],
        [
          "2",
          "Ana",
          "2024-02-20"
        ]
      ],
      "options": {
        "header": true,
        "headerLine": true,
        "edgeDelimiters": true,
        "minWidth": 3,
        "maxWidth": 0,
        "showNull": false,
        "lineBreak": "lf"
      },
      "expected": "|id |nome |criado    |\n|---|-----|----------|\n|1  |Bruna|2024-01-15|\n|2  |Ana  |2024-02-20|\n",
      "cutValues": 0
    },
    {
      "name": "CRLF",
