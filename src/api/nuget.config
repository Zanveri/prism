<?xml version="1.0" encoding="utf-8"?>
<!--
  Fonte do restore da API: só o nuget.org (RN-ABERTO-002). O `clear` descarta as fontes da máquina, e o
  mapeamento amarra todo pacote ao nuget.org, para que uma fonte acrescentada no perfil de quem desenvolve
  não possa fornecer um pacote homônimo no lugar do público. Sem credencial: quem clona restaura.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
