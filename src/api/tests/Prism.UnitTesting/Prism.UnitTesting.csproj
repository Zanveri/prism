<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- RN-VERSAO-005: um cofre do formato 1 gravado antes da regra, aberto em VaultFormatOneSampleTests. -->
    <EmbeddedResource Include="Vault/Samples/vault-format-1.json" LogicalName="vault-format-1.json" />
    <!-- RN-VERSAO-005 e RN-ABAS-006: um cofre do formato 2 gravado antes do formato 3, aberto em VaultFormatTwoSampleTests. -->
    <EmbeddedResource Include="Vault/Samples/vault-format-2.json" LogicalName="vault-format-2.json" />
    <!-- RN-VERSAO-005 e RN-SCRIPT-011: um cofre do formato 3 gravado antes do formato 4, aberto em VaultFormatThreeSampleTests. -->
    <EmbeddedResource Include="Vault/Samples/vault-format-3.json" LogicalName="vault-format-3.json" />
    <!-- RN-TRANSF-007: um arquivo de exportação de conexões do formato 1, gerado pelo código antes de qualquer mudança do formato, aberto em ConnectionFileFormatOneSampleTests. -->
    <EmbeddedResource Include="ConnectionTransfers/Samples/connections-format-1.prismconexoes" LogicalName="connections-format-1.prismconexoes" />
  </ItemGroup>

  <ItemGroup>
    <!-- RN-EXPORT-024: as fixtures de ouro da exportação de dados, fora das pastas da tela e da API, que os testes dos dois lados leem. -->
    <Content Include="../../../test-fixtures/export/*.json" Link="test-fixtures/export/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Prism.Api\Prism.Api.csproj" />
    <ProjectReference Include="..\..\Prism.Infrastructure\Prism.Infrastructure.csproj" />
    <ProjectReference Include="..\Prism.TestingCore\Prism.TestingCore.csproj" />
  </ItemGroup>

</Project>
